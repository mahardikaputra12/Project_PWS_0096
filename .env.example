# === Database (Supabase / PostgreSQL) ===
# Ambil dari Supabase > Project Settings > Database > Connection string (URI, mode: Session/Transaction)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST.supabase.co:5432/postgres

# === JWT ===
JWT_SECRET=ganti_dengan_secret_yang_panjang_dan_acak
JWT_EXPIRES_IN=1d

# === App ===
PORT=3000
NODE_ENV=development

# Jumlah request gratis per API key per hari (informasi saja, dipakai di future rate-limit per key)
DEFAULT_DAILY_QUOTA=1000
